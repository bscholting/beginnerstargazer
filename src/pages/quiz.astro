---
// src/pages/quiz.astro
import Base from '../layouts/Base.astro';
import SkyQuiz from '../components/SkyQuiz';
---

<Base
  title="Find My Telescope Quiz"
  description="Answer 5 quick questions and discover exactly which telescope is right for your budget, goals, and experience level."
>
  <section class="pt-20 pb-24">
    <div class="container-narrow">
      <div class="text-center mb-12 animate-fade-up">
        <span class="text-5xl block mb-4">🔭</span>
        <h1 class="font-display text-4xl md:text-5xl text-star-white font-bold mb-4">
          Find Your Perfect Telescope
        </h1>
        <p class="text-star-silver/70 text-lg max-w-md mx-auto leading-relaxed">
          5 quick questions. A personalised recommendation based on your budget,
          goals, and experience. No upselling — just honest advice.
        </p>
      </div>

      <div class="card border-nebula-blue/20 p-8 md:p-10 animate-fade-up delay-1">
        <SkyQuiz client:load />
      </div>

      <p class="text-center text-xs text-star-silver/30 font-sans mt-6">
        We earn a small commission if you buy through our links — at no extra cost to you.
        Recommendations are always based on merit, never commission rates.
      </p>
    </div>
  </section>
</Base>
