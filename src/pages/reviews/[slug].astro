---
import Review from '../../layouts/Review.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({ data }) => !data.draft);
  return reviews.map(r => ({ params: { slug: r.id }, props: { review: r } }));
}

const { review } = Astro.props;
const { Content } = await render(review);
const d = review.data;
---

<Review
  title={d.title}
  description={d.description}
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  productName={d.productName}
  brand={d.brand}
  price={d.price}
  rating={d.rating}
  verdict={d.verdict}
  affiliateUrl={d.affiliateUrl}
  affiliateStore={d.affiliateStore}
  whoIsItFor={d.whoIsItFor}
  whoShouldSkip={d.whoShouldSkip}
  bestAlternative={d.bestAlternative}
  pros={d.pros}
  cons={d.cons}
  image={d.image}
  specs={d.specs as Record<string, string> | undefined}
>
  <Content />
</Review>