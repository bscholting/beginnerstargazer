---
// src/components/ProductBox.astro
interface Props {
  name:         string;
  price:        number;
  rating:       number;
  affiliateUrl: string;
  store?:       string;
  image?:       string;
}

const { name, price, rating, affiliateUrl, store = 'Amazon', image } = Astro.props;
const stars = '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating));
---

<div class="product-box">
  <div class="flex flex-col sm:flex-row gap-5 items-start sm:items-center relative z-10">
    {image && (
      <img src={image} alt={name}
           class="w-24 h-24 object-contain rounded-lg bg-space-800 p-2 flex-shrink-0" />
    )}
    <div class="flex-1 min-w-0">
      <p class="font-sans text-xs font-semibold tracking-wider uppercase text-nebula-teal/80 mb-1">
        Our Pick
      </p>
      <h3 class="font-display text-xl text-star-white font-bold mb-2 leading-snug">
        {name}
      </h3>
      <div class="flex items-center gap-3 mb-3">
        <span class="text-star-gold text-sm tracking-wide">{stars}</span>
        <span class="font-sans text-sm text-star-silver/60">{rating}/5</span>
      </div>
      <p class="font-display text-2xl text-star-gold font-bold">
        ${price.toLocaleString()}
        <span class="font-sans text-sm text-star-silver/50 font-normal ml-2">on {store}</span>
      </p>
    </div>
    <div class="flex-shrink-0 sm:self-center">
      <a href={affiliateUrl}
         target="_blank"
         rel="noopener noreferrer nofollow"
         class="buy-btn">
        Check Price on {store}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <p class="font-sans text-xs text-star-silver/40 mt-2 text-center">
        Prices may vary
      </p>
    </div>
  </div>
</div>
